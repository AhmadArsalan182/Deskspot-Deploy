// DeskSpot data model.
//
// Time handling: every booking is stored as an absolute instant in UTC
// (`start_utc` / `end_utc`). Office-local wall-clock times are derived on read
// using the office's IANA time zone, so the model stays unambiguous across DST
// changes (e.g. Copenhagen). See docs/adr/0003-time-and-time-zone-handling.md.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum SpaceType {
  DESK
  ROOM
}

enum BookingStatus {
  ACTIVE
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Brute-force throttling. Consecutive failures are counted server-side; once
  // the threshold is reached the account is locked until `lockedUntil` passes.
  // A successful login or a password reset clears both fields.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  bookings             Booking[]
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

/// Single-use, short-lived tokens backing the "forgot password" flow. Only the
/// SHA-256 hash of the token is stored, so a database leak cannot be replayed.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Office {
  id        String   @id @default(uuid())
  name      String
  city      String
  timezone  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  spaces Space[]

  @@map("offices")
}

model Space {
  id        String    @id @default(uuid())
  name      String
  type      SpaceType
  capacity  Int       @default(1)
  isActive  Boolean   @default(true) @map("is_active")
  officeId  String    @map("office_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  office   Office    @relation(fields: [officeId], references: [id], onDelete: Restrict)
  bookings Booking[]

  // Space names are unique within an office so admins cannot create duplicates.
  @@unique([officeId, name])
  @@map("spaces")
}

model Booking {
  id            String        @id @default(uuid())
  spaceId       String        @map("space_id")
  userId        String        @map("user_id")
  startUtc      DateTime      @map("start_utc")
  endUtc        DateTime      @map("end_utc")
  attendees     Int           @default(1)
  status        BookingStatus @default(ACTIVE)
  cancelReason  String?       @map("cancel_reason")
  cancelledById String?       @map("cancelled_by_id")
  cancelledAt   DateTime?     @map("cancelled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Supports the overlap query (space + time window) and my-bookings listing.
  @@index([spaceId, startUtc, endUtc])
  @@index([userId, startUtc])
  @@map("bookings")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  message   String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
