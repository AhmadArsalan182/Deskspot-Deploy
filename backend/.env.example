# --- Server ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# Origin allowed by CORS (the frontend). Absolute URL, no trailing slash.
# Comma-separate extra origins if you have both localhost and a Vercel URL.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskspot?schema=public"
# Optional: used by the integration tests so they never touch dev data.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskspot_test?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# Shared code that unlocks administrator sign-up on /register?portal=ADMIN.
# Change it per environment; rotate it whenever an admin leaves the team.
ADMIN_INVITE_CODE="DESKSPOT-ADMIN"

# Return the one-time password-reset token in the API response instead of
# emailing it. Handy locally because there is no mail transport; a deployment
# MUST set this to false and wire a real sender.
EXPOSE_RESET_TOKEN="true"
